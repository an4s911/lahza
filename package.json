{
  "name": "lahza",
  "version": "0.3.1",
  "description": "Obsidian plugin: notes with created/modified dates, AI titles and inbox filing, folder indexes and in-note math.",
  "author": "Anas Bashir (https://anasbashir.com)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "node --test test/*.test.ts",
    "deploy": "node scripts/deploy.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/node": "^26.6.5",
    "builtin-modules": "^5.4.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2"
  }
}
